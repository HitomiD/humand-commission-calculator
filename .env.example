# Copy to .env and fill in. .env is git-ignored.
PAYMENTS_API_URL=http://localhost:4000/api/stripe/payments
GEMINI_API_KEY=
# Optional; defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash
# Optional, 0 to 2; defaults to 0. The page can override it for one run.
# GEMINI_TEMPERATURE=0
# Optional: a folder with your own hubspot_deals.csv and pagos_aprobados.csv
# (same columns as data/). Relative paths start from where you run uvicorn.
# Defaults to data/ in the repo.
# DATA_DIR=/path/to/your/data
